# --- Required ---

# Get free at https://twelvedata.com (800 requests/day, 8/min on free tier)
TWELVE_DATA_API_KEY=

# Your existing Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Upstash Redis (free) — created automatically if you use the Vercel
# "Upstash" marketplace integration, which sets these two for you.
# Otherwise get them free at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# A secret password ONLY you (the admin) know — used to log into /admin
# and generate access keys for users. Make this long/random.
ADMIN_SECRET=change-me-to-something-long-and-random

# Secret used by Vercel Cron to call /api/cron/scan so randoms can't
# trigger it. Vercel automatically sends this header on its own cron
# calls if you set it — see README.
CRON_SECRET=change-me-too
